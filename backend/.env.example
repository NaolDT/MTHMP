NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mthmp?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES=7d

SUPER_ADMIN_EMAIL=superadmin@mthmp.dev
SUPER_ADMIN_PASSWORD=ChangeMe123!

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mthmp.dev
# ReliefWeb API appname — requires pre-approval, apply at https://apidoc.reliefweb.int
